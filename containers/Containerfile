# syntax=docker/dockerfile:1
# Fedora 44 currently resolves to this digest; bump only with a reviewed rebuild.
# MLT 7.40.0 here was verified to produce byte-identical output to F43's 7.36.1
# (SSIM 1.000000 on all planes for the reference production) despite the
# linear-light `luma` change flagged in the plan. See docs/decisions.md.
FROM fedora:44@sha256:125c2106ffaa3b2035c5bb480355c6bee73f723bfab47012bb29269d97ec61e4 AS studio

# HyperFrames' upstream render layer is Debian-based.  Keeping it as a named
# stage makes the browser and Node provenance visible; Fedora still owns MLT,
# ffmpeg, Python, and the service runtime below.
FROM node:22-bookworm-slim AS hyperframes-render
ARG TARGETARCH
ARG HYPERFRAMES_VERSION=latest
ARG PLAYWRIGHT_VERSION=1.61.1
RUN apt-get -o APT::Sandbox::User=root update && apt-get -o APT::Sandbox::User=root install -y --no-install-recommends ca-certificates curl unzip ffmpeg chromium \
    libgbm1 libnss3 libatk-bridge2.0-0 libdrm2 libxcomposite1 libxdamage1 libxrandr2 \
    libcups2 libasound2 libpangocairo-1.0-0 libxshmfence1 libgtk-3-0 fontconfig \
    fonts-liberation fonts-noto-color-emoji fonts-noto-cjk fonts-noto-core fonts-noto-extra \
    fonts-noto-ui-core fonts-freefont-ttf fonts-dejavu-core && rm -rf /var/lib/apt/lists/* && fc-cache -fv
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium CONTAINER=true
RUN if [ "$TARGETARCH" = "amd64" ]; then npx --yes @puppeteer/browsers install chrome-headless-shell@stable --path /root/.cache/puppeteer; else npx --yes playwright-core@${PLAYWRIGHT_VERSION} install chromium-headless-shell; fi
RUN npm install -g hyperframes@${HYPERFRAMES_VERSION}
# Vendor GSAP into the image. Boards must load /vendor/gsap.min.js locally: the
# stock blank template points at cdn.jsdelivr.net, which fails in an offline
# container and aborts the render with sub_timeline_script_failure.
RUN mkdir -p /tmp/gsap-fetch \
    && cd /tmp/gsap-fetch \
    && npm install --no-save --prefix /tmp/gsap-fetch gsap@3 \
    && mkdir -p /opt/impromptu/vendor \
    && cp /tmp/gsap-fetch/node_modules/gsap/dist/gsap.min.js /opt/impromptu/vendor/gsap.min.js \
    && test -s /opt/impromptu/vendor/gsap.min.js \
    && rm -rf /tmp/gsap-fetch
RUN SHELL_PATH=$(find /root/.cache/puppeteer /root/.cache/ms-playwright \( -name chrome-headless-shell -o -name headless_shell \) -type f 2>/dev/null | head -1) && test -n "$SHELL_PATH" && printf '%s\n' '#!/bin/sh' "export PRODUCER_HEADLESS_SHELL_PATH=$SHELL_PATH" 'exec hyperframes render "$@"' > /usr/local/bin/hf-render && chmod +x /usr/local/bin/hf-render

FROM studio
ARG WHISPER_CPP_REF=master
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
# RPM Fusion's full ffmpeg replaces Fedora's ffmpeg-free so libx264 is present.
# Without it MLT falls back to mpeg4 Simple Profile and the master is visibly
# blocky; libopenh264 also has no CRF mode, only bitrate targeting.
# `--allowerasing` lets the full build displace the ffmpeg-free stack pulled in
# as an mlt dependency.
RUN dnf -y install \
      "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm" \
    && dnf -y upgrade \
    && dnf -y install --allowerasing \
    python3 python3-devel gcc gcc-c++ make cmake git curl \
    mlt mlt-qt6 ffmpeg fontconfig \
    google-noto-sans-fonts google-noto-mono-fonts dejavu-sans-fonts \
    && ffmpeg -hide_banner -h encoder=libx264 >/dev/null \
    && dnf clean all && fc-cache -fv

# Build whisper.cpp from source. The model is intentionally a declared mount/
# build input rather than a silently downloaded multi-hundred-MB artifact.
RUN git clone --depth 1 --branch ${WHISPER_CPP_REF} https://github.com/ggerganov/whisper.cpp.git /opt/whisper.cpp \
    && cmake -S /opt/whisper.cpp -B /opt/whisper.cpp/build -DWHISPER_BUILD_TESTS=OFF \
    && cmake --build /opt/whisper.cpp/build --config Release -j2 \
    && ln -s /opt/whisper.cpp/build/bin/whisper-cli /usr/local/bin/whisper-cli \
    && whisper-cli --help >/dev/null 2>&1 || test -x /usr/local/bin/whisper-cli \
    && mkdir -p /models \
    && printf '%s\n' 'Mount ggml-base.en.bin at /models/ggml-base.en.bin; no model is bundled.' > /models/README

# Copy the tested HyperFrames render layer. Fedora runtime package names above
# supply the shared libraries; if a cross-distro browser fails, the build fails.
COPY --from=hyperframes-render /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=hyperframes-render /usr/local/bin/hf-render /usr/local/bin/hf-render
COPY --from=hyperframes-render /root/.cache /root/.cache
COPY --from=hyperframes-render /usr/local/bin/node /usr/local/bin/node
COPY --from=hyperframes-render /opt/impromptu/vendor /opt/impromptu/vendor
ENV PATH=/usr/local/bin:$PATH NODE_PATH=/usr/local/lib/node_modules \
    IMPROMPTU_VENDOR=/opt/impromptu/vendor
# Recreate npm's bin symlink rather than COPYing /usr/local/bin/hyperframes.
# A plain-file copy resolves its relative `../dist/...` imports against
# /usr/local/ instead of the package directory, so the CLI dies with
# ERR_MODULE_NOT_FOUND for /usr/local/dist/runtimeVersion.js.
RUN HF_BIN=$(node -e "const p=require('/usr/local/lib/node_modules/hyperframes/package.json');const b=p.bin;process.stdout.write(typeof b==='string'?b:b.hyperframes||Object.values(b)[0])") \
    && ln -sf "/usr/local/lib/node_modules/hyperframes/$HF_BIN" /usr/local/bin/hyperframes \
    && chmod +x "/usr/local/lib/node_modules/hyperframes/$HF_BIN" \
    && hyperframes --version
# Resolve the browser once at build time and bake it into the image
# environment, so calling `hyperframes` directly (not just the hf-render
# wrapper) still finds the pinned shell and uses BeginFrame capture.  A stale
# literal path here silently disables it.
RUN SHELL_PATH=$(find /root/.cache/puppeteer /root/.cache/ms-playwright \
      \( -name chrome-headless-shell -o -name headless_shell \) -type f 2>/dev/null | head -1) \
    && test -n "$SHELL_PATH" \
    && printf 'PRODUCER_HEADLESS_SHELL_PATH=%s\n' "$SHELL_PATH" >> /etc/environment \
    && ln -sf "$SHELL_PATH" /usr/local/bin/chrome-headless-shell
ENV PRODUCER_HEADLESS_SHELL_PATH=/usr/local/bin/chrome-headless-shell

# ── non-root service user ─────────────────────────────────────────────────────
# The unit runs under UserNS=keep-id, so the container maps to the HOST user
# (uid 1000). Nothing the service touches may live under /root (0700, owned by
# root): uid 1000 cannot traverse it, so the original /root/.local/bin/uv
# entrypoint died instantly ("Permission denied"). Relocate both root-owned
# tools the runtime needs -- uv and the chromium shell -- into world-reachable
# paths, and run the service as a uid-1000 account so host bind-mount
# ownership lines up without touching the host.
RUN useradd --uid 1000 --create-home --shell /bin/bash studio \
    && mkdir -p /usr/local/libexec

# Resolve the baked chromium shell, then COPY it (not symlink) out of /root/
# .cache so the non-root service user can actually execute it for board renders.
RUN SHELL_PATH=$(find /root/.cache/puppeteer /root/.cache/ms-playwright \
      \( -name chrome-headless-shell -o -name headless_shell \) -type f 2>/dev/null | head -1) \
    && test -n "$SHELL_PATH" \
    && cp "$SHELL_PATH" /usr/local/libexec/impromptu-chrome-headless-shell \
    && chmod 0755 /usr/local/libexec/impromptu-chrome-headless-shell \
    && ln -sf /usr/local/libexec/impromptu-chrome-headless-shell /usr/local/bin/chrome-headless-shell

WORKDIR /app
COPY . /app
# uv's installer targets ~/.local/bin (under /root as root). Install, then copy
# the binary to /usr/local/bin so the non-root service user can reach it.
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && cp /root/.local/bin/uv /usr/local/bin/uv \
    && chmod 0755 /usr/local/bin/uv \
    && /usr/local/bin/uv sync --extra web --no-dev \
    && chown -R studio:studio /app
ENV HOME=/home/studio
EXPOSE 8787
USER studio
CMD ["/usr/local/bin/uv", "run", "--no-sync", "uvicorn", "api.http:app", "--host", "0.0.0.0", "--port", "8787"]
